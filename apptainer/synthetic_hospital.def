# Apptainer definition for Synthetic Hospital (simulator + Postgres + Redis in one image).
#
# Builds from the published all-in-one image; no Docker needed on the build machine:
#     apptainer build synthetic_hospital.sif apptainer/synthetic_hospital.def
# To build from a locally built Docker image instead, use synthetic_hospital.local.def.
#
# Run (see apptainer/README.md for the state directory and ports):
#     mkdir -p $HOME/sh-state
#     apptainer run --bind $HOME/sh-state:/var/lib/synthetic-hospital synthetic_hospital.sif
#     apptainer instance start --bind $HOME/sh-state:/var/lib/synthetic-hospital synthetic_hospital.sif sh

Bootstrap: docker
From: ghcr.io/sparkcpark/synthetic-hospital:1.3-allinone

%environment
    export PYTHONPATH=/app
    export SH_STATE_DIR=/var/lib/synthetic-hospital
    export PATH=/usr/lib/postgresql/bin:$PATH

%runscript
    exec /usr/local/bin/allinone.sh "$@"

%startscript
    exec /usr/local/bin/allinone.sh serve

%labels
    org.opencontainers.image.title Synthetic Hospital
    org.opencontainers.image.description Open, verifiable longitudinal EHR benchmark and RL environment (v1.3)

%help
    Synthetic Hospital v1.3: FHIR EHR simulator, evaluation harness, scoring and RL endpoints.
    The container starts PostgreSQL and Redis internally as the calling user, loads the
    benchmark database on first boot, and serves the API on port 8000.
      apptainer run --bind <dir>:/var/lib/synthetic-hospital synthetic_hospital.sif        # serve
      apptainer run --bind <dir>:/var/lib/synthetic-hospital synthetic_hospital.sif pytest eval/tests
    The state directory needs a few hundred MB; --writable-tmpfs is too small unless the
    session directory size is raised in apptainer.conf.
